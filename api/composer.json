{
    "name": "web-security-lab/academy-api",
    "description": "API учебного полигона безопасной веб-разработки",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-json": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/dbal": "^4.3",
        "monolog/monolog": "^3.9",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "qa": ["@stan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {"php": "8.5.0"}
    }
}
